{
  "api_key_env": "ANTHROPIC_AUTH_TOKEN",
  "default_test_ratio": 0.5,
  "output_dir": "data",
  "sensitive_words_file": "references/sensitive_words.json",
  "templates_dir": "references/templates",
  "high_value_threshold": 0.9,
  "price_sensitive_threshold": 0.75,
  "generic_copy": "亲爱的会员，我们一直想念您，期待您的归来。",
  "model_provider": "auto",
  "supported_providers": {
    "auto": {
      "description": "自动检测可用的大模型",
      "env_keys": ["ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY", "ZHIPU_API_KEY", "DASHSCOPE_API_KEY", "ERNIE_API_KEY", "DEEPSEEK_API_KEY"]
    },
    "anthropic": {
      "description": "Anthropic Claude",
      "env_key": "ANTHROPIC_AUTH_TOKEN",
      "model": "claude-sonnet-4-20250514",
      "api_base": "https://api.anthropic.com"
    },
    "zhipu": {
      "description": "智谱清言 (GLM)",
      "env_key": "ZHIPU_API_KEY",
      "model": "glm-4",
      "api_base": "https://open.bigmodel.cn/api/paas/v4"
    },
    "tongyi": {
      "description": "阿里云通义千问",
      "env_key": "DASHSCOPE_API_KEY",
      "model": "qwen-turbo",
      "api_base": "https://dashscope.aliyuncs.com/api/v1"
    },
    "wenxin": {
      "description": "百度文心一言",
      "env_key": "ERNIE_API_KEY",
      "model": "ernie-4.0-8k",
      "api_base": "https://aip.baidubce.com/rpc/2.0/ai_custom/v1"
    },
    "deepseek": {
      "description": "DeepSeek",
      "env_key": "DEEPSEEK_API_KEY",
      "model": "deepseek-chat",
      "api_base": "https://api.deepseek.com"
    },
    "moonshot": {
      "description": "月之暗面 Kimi",
      "env_key": "MOONSHOT_API_KEY",
      "model": "moonshot-v1-8k",
      "api_base": "https://api.moonshot.cn/v1"
    },
    "stepfun": {
      "description": "阶跃星辰 (StepFun)",
      "env_key": "STEPFUN_API_KEY",
      "model": "step-1-8k",
      "api_base": "https://api.stepfun.com/api/v1"
    },
    "tencent": {
      "description": "腾讯混元",
      "env_key": "TENCENT_HUNYAN_API_KEY",
      "model": "hunyuan",
      "api_base": "https://hunyuan.tencentcloudapi.com"
    }
  },
  "sensitive_words": {
    "version": "1.0",
    "last_updated": "2026-04-02",
    "words": {
      "forbidden": [
        {"word": "最高", "replacement": "高品质"},
        {"word": "国家级", "replacement": ""},
        {"word": "最佳", "replacement": "优质"},
        {"word": "第一", "replacement": "领先"},
        {"word": "顶级", "replacement": "高端"},
        {"word": "顶尖", "replacement": "卓越"},
        {"word": "绝对", "replacement": "非常"},
        {"word": "100%", "replacement": "高品质"}
      ],
      "extreme": [
        {"word": "唯一", "replacement": "仅有"},
        {"word": "首选", "replacement": "推荐"},
        {"word": "首家", "replacement": "较早推出"},
        {"word": "最先进", "replacement": "先进"}
      ],
      "inducing": [
        {"word": "立即抢购", "warning": true},
        {"word": "过期不候", "warning": true},
        {"word": "马上领取", "warning": true},
        {"word": "不容错过", "warning": true},
        {"word": "最后机会", "warning": true},
        {"word": "限时优惠", "warning": true}
      ],
      "personal_info": [
        {"word": "身份证", "warning": true},
        {"word": "银行卡", "warning": true},
        {"word": "密码", "warning": true},
        {"word": "验证码", "warning": true}
      ],
      "false_claim": [
        {"word": "保证收益", "warning": true},
        {"word": "无风险", "warning": true},
        {"word": "100%有效", "warning": true},
        {"word": "根治", "warning": true},
        {"word": "彻底治愈", "warning": true}
      ]
    }
  }
}